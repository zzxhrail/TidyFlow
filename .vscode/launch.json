{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 DeskFlow 面板",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/DeskFlow.App/bin/Debug/net10.0-windows/DeskFlow.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/DeskFlow.App/bin/Debug/net10.0-windows",
      "console": "internalConsole",
      "stopAtEntry": false,
      "requireExactSource": false
    },
    {
      "name": "调试 命令行批处理（--diagnose）",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/DeskFlow.App/bin/Debug/net10.0-windows/DeskFlow.dll",
      "args": ["--diagnose"],
      "cwd": "${workspaceFolder}/src/DeskFlow.App/bin/Debug/net10.0-windows",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "调试 自检程序",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tests/DeskFlow.Checks/bin/Debug/net10.0/DeskFlow.Checks.dll",
      "cwd": "${workspaceFolder}/tests/DeskFlow.Checks",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
