<Window x:Class="DeskFlow.App.Scan.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫描磁盘" Height="720" Width="1020" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="14"
        TextOptions.TextFormattingMode="Display">
    <Window.Background>
        <SolidColorBrush Color="#FF202020" />
    </Window.Background>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="扫描磁盘" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="按盘符扫盘，自动跳过系统目录（Windows / Program Files / ProgramData / AppData / 回收站等）与程序目录。只读扫描，不会动任何文件。" />
        </StackPanel>

        <!-- 条件 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="扫描范围" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                <WrapPanel x:Name="DrivePanel" />

                <TextBlock Text="文件类型" Style="{StaticResource Muted}" Margin="0,14,0,6" />
                <WrapPanel>
                    <TextBox x:Name="ExtensionBox" Width="420" MinHeight="32"
                             Text=".docx .doc .xlsx .xls .pptx .pdf .txt .md .csv .png .jpg .jpeg .zip .rar .7z" />
                    <Button Content="只选文档" Click="PresetDocs_Click" Margin="8,0,0,0" />
                    <Button Content="只选图片" Click="PresetImages_Click" Margin="8,0,0,0" />
                    <Button Content="全部类型" Click="PresetAll_Click" Margin="8,0,0,0" />
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="时间范围" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}" />
                    <ComboBox x:Name="RangeBox" Width="150" SelectedIndex="2">
                        <ComboBoxItem Content="不限时间" />
                        <ComboBoxItem Content="最近 1 天" />
                        <ComboBoxItem Content="最近 7 天" />
                        <ComboBoxItem Content="最近 30 天" />
                        <ComboBoxItem Content="最近 90 天" />
                        <ComboBoxItem Content="最近一年" />
                    </ComboBox>

                    <TextBlock Text="最小文件" VerticalAlignment="Center" Margin="20,0,6,0" Style="{StaticResource Muted}" />
                    <ComboBox x:Name="SizeBox" Width="130" SelectedIndex="0">
                        <ComboBoxItem Content="1 KB" />
                        <ComboBoxItem Content="100 KB" />
                        <ComboBoxItem Content="1 MB" />
                        <ComboBoxItem Content="10 MB" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 操作 -->
        <DockPanel Grid.Row="2" Margin="0,14,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="ScanButton" Content="开始扫描" Click="Scan_Click" Style="{StaticResource AccentButton}" />
                <Button x:Name="StopButton" Content="停止" Click="Stop_Click" Margin="8,0,0,0" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="StatusText" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource Muted}" />
        </DockPanel>

        <!-- 结果 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6">
            <ListView x:Name="ResultList" SelectionMode="Extended" Background="Transparent" BorderThickness="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="ToolTip" Value="{Binding Path}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="文件" Width="300" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Header="修改时间" Width="140" DisplayMemberBinding="{Binding ModifiedText}" />
                        <GridViewColumn Header="所在目录" Width="380" DisplayMemberBinding="{Binding Directory}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- 底部 -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Style="{StaticResource Muted}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="全选" Click="SelectAll_Click" Margin="0,0,8,0" />
                <Button Content="在资源管理器中显示" Click="Reveal_Click" Margin="0,0,8,0" />
                <Button Content="归档选中" Click="ArchiveSelected_Click" Style="{StaticResource AccentButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
