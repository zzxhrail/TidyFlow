<Window x:Class="DeskFlow.App.Install.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装 TidyFlow" Width="660" Height="700" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display">
    <Window.Background>
        <SolidColorBrush Color="#FF202020" />
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部品牌条 -->
        <Border Grid.Row="0" Background="Transparent" Padding="24,20,24,14">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="HeaderLogo" Width="36" Height="36" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="TidyFlow 安装程序" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Text="版本 0.6.0 · 仅安装到当前用户，无需管理员权限"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 主体 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18">

                <Border x:Name="ExistingBox" Background="#26FFC46B" BorderBrush="#4DFFC46B" BorderThickness="1"
                        CornerRadius="6" Padding="12,9" Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock x:Name="ExistingText" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                </Border>

                <TextBlock Text="安装位置" FontWeight="SemiBold" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Grid.Column="0" Padding="8,6" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Content="浏览…" Click="Browse_Click" Margin="8,0,0,0" Padding="14,6" />
                </Grid>
                <TextBlock Text="默认装在用户目录下，不需要管理员；卸载时不会动你的文件与配置。"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" />

                <TextBlock Text="安装选项" FontWeight="SemiBold" Margin="0,18,0,8" />
                <Border Style="{StaticResource GlassCard}" Padding="14,10">
                    <StackPanel>
                        <CheckBox x:Name="AutostartCheck" IsChecked="True" Margin="0,4"
                                  Content="开机自动启动（登录后自动打开面板并按规则归档）" />
                        <CheckBox x:Name="DesktopCheck" IsChecked="True" Margin="0,4" Content="创建桌面快捷方式" />
                        <CheckBox x:Name="StartMenuCheck" IsChecked="True" Margin="0,4" Content="创建开始菜单快捷方式" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="HintText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,14,0,0" TextWrapping="Wrap"
                           Text="安装过程会：复制程序到上面这个目录 → 建快捷方式 → 写入「设置 → 应用」里的卸载项。" />

                <!-- 安装进度：进度条 + 当前步骤 + 步骤清单 -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,18,0,0">
                    <DockPanel>
                        <TextBlock x:Name="PercentText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ProgressBar x:Name="Progress" Style="{StaticResource FluentProgress}" Height="6"
                                 Minimum="0" Maximum="100" Margin="0,8,0,0" />

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock x:Name="Step1" Style="{StaticResource Muted}" Text="○  准备安装目录" Margin="0,2" />
                        <TextBlock x:Name="Step2" Style="{StaticResource Muted}" Text="○  复制程序文件（约 66 MB）" Margin="0,2" />
                        <TextBlock x:Name="Step3" Style="{StaticResource Muted}" Text="○  创建快捷方式" Margin="0,2" />
                        <TextBlock x:Name="Step4" Style="{StaticResource Muted}" Text="○  开机自启与卸载项" Margin="0,2" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="Transparent" BorderBrush="#12FFFFFF" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" x:Name="FooterHint" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"
                           VerticalAlignment="Center" Text="关闭窗口即取消安装" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Padding="18,7" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="InstallButton" Content="开始安装" Click="Install_Click" Padding="22,7"
                            Style="{StaticResource PrimaryButton}" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>