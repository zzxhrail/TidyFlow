<Window x:Class="DeskFlow.App.Install.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卸载 DeskFlow" Width="560" Height="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display">
    <Window.Background>
        <SolidColorBrush Color="#FF202020" />
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" Padding="24,20,24,14">
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="8" Background="#FFCA3A3E">
                    <TextBlock Text="×" Foreground="White" FontWeight="Bold" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="卸载 DeskFlow" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Text="仅移除程序本身" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="22,18">
            <Border Style="{StaticResource GlassCard}" Padding="14,10">
                <StackPanel>
                    <TextBlock x:Name="LocationText" Text="安装位置：—" TextWrapping="Wrap" />
                    <TextBlock x:Name="SizeText" Text="占用空间：—" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <CheckBox x:Name="KeepDataCheck" IsChecked="True" Margin="0,16,0,0"
                      Content="保留我的配置与归档索引（%LOCALAPPDATA%DeskFlow）" />
            <TextBlock Text="不勾选会连配置、日志、归档索引一起删除；归档目录里的文件永远不会被删。"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="2,6,0,0" TextWrapping="Wrap" />

            <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="100" Margin="0,18,0,0"
                         Foreground="{StaticResource DangerBrush}" Background="#0FFFFFFF" BorderThickness="0" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2" Background="Transparent" BorderBrush="#12FFFFFF" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Padding="18,7" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" />
                <Button x:Name="UninstallButton" Content="卸载" Click="Uninstall_Click" Padding="22,7"
                        Style="{StaticResource DangerButton}" FontWeight="SemiBold" />
            </StackPanel>
        </Border>
    </Grid>
</Window>