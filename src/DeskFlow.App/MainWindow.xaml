<Window x:Class="DeskFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TidyFlow · 批量文件盘点与报表" Height="720" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F6F7F9"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="TidyFlow" FontSize="22" FontWeight="SemiBold" Foreground="#1F2329" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="扫描目录 → 逐条跑处理步骤 → 输出 report.csv / report.json。原始文件只读，不会被修改。" />
        </StackPanel>

        <!-- 输入路径 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="输入路径" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="可以是文件夹，也可以是单个文件" />
            <Button Grid.Column="2" Content="浏览…" Click="BrowseInput_Click" Margin="8,0,0,0" />
        </Grid>

        <!-- 输出目录 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="输出目录" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Content="浏览…" Click="BrowseOutput_Click" Margin="8,0,0,0" />
        </Grid>

        <!-- 步骤 -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E5E6EB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="处理步骤（按顺序执行，来自组件目录）" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding StepOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,24,6" VerticalContentAlignment="Center"
                                      ToolTip="{Binding Description}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" Margin="8,0,0,0" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="递归子目录" IsChecked="{Binding Recurse, Mode=TwoWay}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- 操作 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="开始处理" Command="{Binding RunCommand}" IsEnabled="{Binding IsIdle}"
                    Background="#2F6BFF" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Height="34" />
            <Button Content="取消" Command="{Binding CancelCommand}" Height="34" />
            <Button Content="打开输出目录" Command="{Binding OpenOutputCommand}" Height="34" />
        </StackPanel>

        <!-- 进度 -->
        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Foreground="#2F6BFF" Background="#E5E6EB" BorderThickness="0" />
            <DockPanel Margin="0,6,0,0">
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Style="{StaticResource Hint}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
            </DockPanel>
        </StackPanel>

        <!-- 日志 -->
        <Border Grid.Row="6" Background="#11151C" CornerRadius="6" Padding="2">
            <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                     Foreground="#C9D1D9" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,1" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="7" Style="{StaticResource Hint}" Margin="0,10,0,0"
                   Text="配置文件：%LOCALAPPDATA%\DeskFlow\settings.json　日志：%LOCALAPPDATA%\DeskFlow\logs" />
    </Grid>
</Window>
