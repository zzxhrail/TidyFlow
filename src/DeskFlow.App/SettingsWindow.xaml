<Window x:Class="DeskFlow.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskFlow 设置" Height="620" Width="880" WindowStartupLocation="CenterOwner"
        Background="#F6F7F9" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <TabControl Margin="12">
        <!-- 1. 监听来源 -->
        <TabItem Header="监听与自动下载">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Hint}" TextWrapping="Wrap" Text="勾选某个来源的「自动下载」：该来源新收到的文件会立刻复制进归档目录并按类别归纳；不勾选则只进面板的「待接收」，由你决定要不要。" />
                <ItemsControl x:Name="SourceList" Grid.Row="1" Margin="0,10,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#E5E6EB" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AutoDownload, Mode=TwoWay}"
                                              Click="AutoDownload_Click" Content="自动下载" IsEnabled="{Binding IsAvailable}"
                                              VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2" Text="已监听的目录" FontWeight="SemiBold" Margin="0,4,0,6" />
                <ListBox x:Name="WatchList" Grid.Row="2" Margin="0,26,0,0" DisplayMemberPath="Display" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="添加监听目录…" Click="AddWatchDir_Click" />
                    <Button Content="移除选中" Click="RemoveWatchDir_Click" />
                    <Button Content="立即扫描一次" Click="ScanNow_Click" />
                    <Button x:Name="AutoScanButton" Content="自动查找数据目录…" Click="AutoScan_Click"
                            ToolTip="扫描各盘符找 QQ/微信/钉钉 的数据目录（客户端改过保存位置时用）" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- 2. 归档 -->
        <TabItem Header="归档位置">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="归档根目录（每个类别一个子文件夹）" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ArchiveRootBox" Grid.Column="0" Padding="8,5" />
                    <Button Grid.Column="1" Content="浏览…" Click="BrowseArchiveRoot_Click" Margin="8,0,0,0" />
                    <Button Grid.Column="2" Content="应用" Click="ApplyArchiveRoot_Click" Margin="8,0,0,0" />
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <CheckBox x:Name="MoveCheck" Content="归档时移动原件（不勾选 = 复制，聊天工具目录里保留一份）" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="打开归档目录" Click="OpenArchive_Click" />
                        <Button Content="清理已忽略记录" Click="ClearIgnored_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- 3. 分类 -->
        <TabItem Header="分类规则">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Hint}" TextWrapping="Wrap"
                           Text="内置类别按扩展名自动归类；下面可以新增自己的类别（同名会覆盖内置）。一个类别多个扩展名用空格或逗号分隔。" />

                <ListBox x:Name="CategoryList" Grid.Row="1" Margin="0,10" />

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBlock Text="类别名" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="CategoryNameBox" Width="140" Padding="6,4" />
                    <TextBlock Text="扩展名" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox x:Name="CategoryExtBox" Width="260" Padding="6,4" Text=".log .bak" />
                    <Button Content="添加/覆盖" Click="AddCategory_Click" Margin="10,0,0,0" />
                    <Button Content="删除选中" Click="RemoveCategory_Click" />
                </StackPanel>

                <TextBlock Grid.Row="3" Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="只有你自己建的类别能删；内置类别固定存在，可用同名自定义覆盖它的扩展名。" />
            </Grid>
        </TabItem>

        <!-- 4. 快捷方式 -->
        <TabItem Header="面板快捷方式">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="显示在桌面面板「应用与快捷方式」里的图标" FontWeight="SemiBold" />
                <ListBox x:Name="ShortcutList" Grid.Row="1" Margin="0,10" DisplayMemberPath="Display" />
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Content="添加程序/文件…" Click="AddShortcutFile_Click" />
                    <Button Content="添加文件夹…" Click="AddShortcutFolder_Click" />
                    <Button Content="移除选中" Click="RemoveShortcut_Click" />
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>