<Window x:Class="DeskFlow.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TidyFlow 设置" Icon="Assets/tidyflow.ico" Height="680" Width="940" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#FF202020" />
        </Grid.Background>

    <TabControl Margin="0" Style="{StaticResource NavTabControl}" TabStripPlacement="Left">
        <!-- 1. 监听来源 -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="监听与自动下载" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="监听与自动下载" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="打开某个来源的开关，它新收到的文件会立刻复制进归档目录并按类别归纳；关掉则只进面板的「待接收」，由你决定要不要。" />
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4,2" Margin="0,16,0,12">
                <ItemsControl x:Name="SourceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource FluentToggle}"
                                                  IsChecked="{Binding AutoDownload, Mode=TwoWay}"
                                                  Click="AutoDownload_Click"
                                                  IsEnabled="{Binding IsAvailable}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="开 = 自动下载并归档；关 = 只进待接收" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Border>

                <TextBlock Grid.Row="2" Text="已监听的目录" Style="{StaticResource H2}" Margin="0,6,0,8" />
                <ListBox x:Name="WatchList" Grid.Row="2" Margin="0,26,0,0" MaxHeight="260">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="12" Margin="2,3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="添加监听目录…" Click="AddWatchDir_Click" />
                    <Button Content="移除选中" Click="RemoveWatchDir_Click" />
                    <Button Content="立即扫描一次" Click="ScanNow_Click" />
                    <Button Content="打开选中目录" Click="OpenWatchDir_Click" />
                    <Button Content="诊断刷新" Click="Diagnose_Click" />
                    <Button x:Name="AutoScanButton" Content="自动查找数据目录…" Click="AutoScan_Click"
                            ToolTip="扫描各盘符找 QQ/微信/钉钉 的数据目录（客户端改过保存位置时用）" />
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- 2. 归档 -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="归档位置" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="归档位置" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="归档根目录（每个类别一个子文件夹）" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ArchiveRootBox" Grid.Column="0" Padding="8,5" />
                    <Button Grid.Column="1" Content="浏览…" Click="BrowseArchiveRoot_Click" Margin="8,0,0,0" />
                    <Button Grid.Column="2" Content="应用" Click="ApplyArchiveRoot_Click" Margin="8,0,0,0" />
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <CheckBox x:Name="MoveCheck" Content="归档时移动原件（不勾选 = 复制，聊天工具目录里保留一份）" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="打开归档目录" Click="OpenArchive_Click" />
                        <Button Content="手动归档文件…" Click="ManualImport_Click" />
                        <Button Content="清理已忽略记录" Click="ClearIgnored_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- 3. 分类 -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="分类规则" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="分类规则" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="内置类别按扩展名自动归类；下面可以新增自己的类别（同名会覆盖内置）。一个类别多个扩展名用空格或逗号分隔。" />
                </StackPanel>

                <ListBox x:Name="CategoryList" Grid.Row="1" Margin="0,10" />

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBlock Text="类别名" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="CategoryNameBox" Width="140" Padding="6,4" />
                    <TextBlock Text="扩展名" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox x:Name="CategoryExtBox" Width="260" Padding="6,4" Text=".log .bak" />
                    <Button Content="添加/覆盖" Click="AddExtensionsByCategory_Click" Margin="10,0,0,0" />
                    <Button Content="删除选中" Click="RemoveCategory_Click" />
                </StackPanel>

                <TextBlock Grid.Row="3" Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="只有你自己建的类别能删；内置类别固定存在，可用同名自定义覆盖它的扩展名。" />
            </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- 5. 全局监听 -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="全局监听" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="全局监听" Style="{StaticResource PageTitle}" />
                    <CheckBox x:Name="GlobalWatchCheck" Margin="0,12,0,0"
                              Content="开启全局监听：整机任意目录只要落盘就收" />
                </StackPanel>
                <Border Grid.Row="1" Margin="0,10,0,0" Background="#1FFFC46B" BorderBrush="#40FFC46B"
                        BorderThickness="1" CornerRadius="4" Padding="12,10">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                               Text="注意：命中的文件会被「移动」到归档目录，原位置不再保留副本。系统目录（Windows / Program Files / AppData / 回收站等）与归档目录本身不会被监听。" />
                </Border>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <DockPanel>
                        <TextBlock Text="监听的文件类型" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="ExtCountText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Style="{StaticResource Card}"
                            Padding="8,8" Margin="0,8,0,0" MinHeight="54" MaxHeight="120">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ExtChipsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1AFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                CornerRadius="4" Padding="9,4" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                        Tag="{Binding}" Click="RemoveExt_Click"
                                                        Background="Transparent" BorderThickness="0" Padding="0"
                                                        Margin="6,0,0,0" Width="14" Height="14" MinWidth="0"
                                                        Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand"
                                                        ToolTip="移除这个类型" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="添加类型" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox x:Name="NewExtBox" Width="120" Padding="6,4"
                                 ToolTip="如 .psd 或 psd；可一次粘贴多个（空格/逗号分隔）" />
                        <Button Content="添加" Click="AddExt_Click" Margin="8,0,0,0" />
                        <TextBlock Text="从分类选" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="#5A6472" />
                        <ComboBox x:Name="KnownExtBox" Width="190" Margin="0,0,0,0" Padding="6,3"
                                  ToolTip="从分类规则里挑（选中即添加）"
                                  SelectionChanged="KnownExtBox_SelectionChanged" />
                        <Button Content="按分类添加 ▾" Click="AddCategory_Click" Margin="8,0,0,0"
                                ToolTip="把某个分类下的所有后缀一次性加进来" />
                        <Button Content="恢复默认" Click="ResetExt_Click" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Text="监听的根目录（默认所有固定硬盘）" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ListBox x:Name="GlobalRootsList" Height="150" />
                </StackPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="添加目录…" Click="AddGlobalRoot_Click" />
                    <Button Content="移除选中" Click="RemoveGlobalRoot_Click" />
                    <Button Content="恢复默认（全部硬盘）" Click="ResetGlobalRoots_Click" />
                </StackPanel>

                <TextBlock Grid.Row="5" Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap"
                           Text="命中后的动作：弹右下角提示 → 按类别移动到归档目录 → 删除原文件。与你手动改的聊天工具目录监听互不重复。" />
            </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- 4. 快捷方式 -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="面板快捷方式" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="显示在桌面面板「应用与快捷方式」里的图标" FontWeight="SemiBold" />
                <ListBox x:Name="ShortcutList" Grid.Row="1" Margin="0,10" DisplayMemberPath="Display" />
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Content="添加程序/文件…" Click="AddShortcutFile_Click" />
                    <Button Content="添加文件夹…" Click="AddShortcutFolder_Click" />
                    <Button Content="移除选中" Click="RemoveShortcut_Click" />
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
    </Grid>
</Window>