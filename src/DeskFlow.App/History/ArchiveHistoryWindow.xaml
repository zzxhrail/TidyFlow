<Window x:Class="DeskFlow.App.History.ArchiveHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="归档记录 · 可撤销" Height="620" Width="1060" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
            <GradientStop Color="#1C1F28" Offset="0" />
            <GradientStop Color="#12141A" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="归档记录" Style="{StaticResource H2}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" Margin="0,3,0,0"
                           Text="选中一条或多条，点「撤销归档」把文件放回原位置" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox x:Name="SearchBox" Width="220" Margin="0,0,8,0"
                         ToolTip="按文件名或类别筛选" TextChanged="Search_Changed" />
                <Button x:Name="SelectAllButton" Content="全选" Click="SelectAll_Click" Margin="0,0,8,0" />
                <Button Content="刷新" Click="Refresh_Click" Margin="0" />
            </StackPanel>
        </DockPanel>

        <!-- 整批撤销 -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="10,8" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="整批撤销" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,10,0" />
                <Button DockPanel.Dock="Right" Content="撤销整批" Click="UndoBatch_Click"
                        Style="{StaticResource DangerButton}" Margin="10,0,0,0" />
                <ComboBox x:Name="BatchBox" Height="30" VerticalContentAlignment="Center" DisplayMemberPath="Display"
                          ToolTip="同一类别、15 秒内连续归档的文件算一批" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="6">
            <ListView x:Name="RecordList" SelectionMode="Extended" Background="Transparent"
                      BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="ToolTip" Value="{Binding OriginalDirectory}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="50">
                            <GridViewColumn.Header>
                                <TextBlock Text="" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="归档时间" Width="130" DisplayMemberBinding="{Binding TimeText}" />
                        <GridViewColumn Header="文件" Width="300" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="类别" Width="90" DisplayMemberBinding="{Binding Category}" />
                        <GridViewColumn Header="来源" Width="90" DisplayMemberBinding="{Binding Source}" />
                        <GridViewColumn Header="原位置（撤销后回到这里）" Width="430" DisplayMemberBinding="{Binding OriginalDirectory}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="打开" Click="Open_Click" Margin="0,0,8,0" />
                <Button Content="在资源管理器中显示" Click="Reveal_Click" Margin="0,0,8,0" />
                <Button x:Name="UndoButton" Content="撤销选中" Click="Undo_Click" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>