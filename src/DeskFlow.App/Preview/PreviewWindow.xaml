<Window x:Class="DeskFlow.App.Preview.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预览" Height="620" Width="820" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="14"
        TextOptions.TextFormattingMode="Display">
    <Window.Background>
        <SolidColorBrush Color="#FF202020" />
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 文件信息 -->
        <Border Grid.Row="0" Padding="24,18,24,12" Background="Transparent">
            <DockPanel>
                <Image x:Name="FileIcon" DockPanel.Dock="Left" Width="36" Height="36" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MetaText" Style="{StaticResource Caption}" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PathText" Style="{StaticResource Muted}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 预览区 -->
        <Border Grid.Row="1" Margin="24,0,24,0" CornerRadius="8" Background="#0AFFFFFF"
                BorderBrush="#12FFFFFF" BorderThickness="1" Padding="8">
            <Grid>
                <Image x:Name="ImagePreview" Stretch="Uniform" Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <ScrollViewer x:Name="TextScroll" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox x:Name="TextPreview" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Top" VerticalAlignment="Top" MinHeight="0"
                             FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12.5"
                             Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </ScrollViewer>
                <StackPanel x:Name="FallbackPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="FallbackTitle" FontSize="16" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="FallbackHint" Style="{StaticResource Muted}" Margin="0,8,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 操作 -->
        <DockPanel Grid.Row="2" Margin="24,14,24,18">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Style="{StaticResource Muted}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenButton" Content="用默认程序打开" Click="Open_Click" Margin="0,0,8,0" />
                <Button x:Name="IgnoreButton" Content="忽略" Click="Ignore_Click" Margin="0,0,8,0" />
                <Button x:Name="AcceptButton" Content="立即归档" Click="Accept_Click" Style="{StaticResource AccentButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
