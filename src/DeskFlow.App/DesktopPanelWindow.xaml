<Window x:Class="DeskFlow.App.DesktopPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DeskFlow 面板" Width="376" Height="640" MinWidth="280" MinHeight="180"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True" Topmost="False"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI" TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 面板底色：接近不透明的深色，有没有云母都清晰；上部略亮一点做层次 -->
        <LinearGradientBrush x:Key="PanelTint" StartPoint="0,0" EndPoint="0.4,1">
            <GradientStop Color="#F21E2129" Offset="0" />
            <GradientStop Color="#F2181A21" Offset="0.5" />
            <GradientStop Color="#F214161C" Offset="1" />
        </LinearGradientBrush>

        <DataTemplate x:Key="TileTemplate">
            <Button Style="{StaticResource TileButton}" Click="Tile_Click" MouseRightButtonUp="Tile_RightClick" Tag="{Binding}"
                    AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding ToolTip}">
                <StackPanel ClipToBounds="True" Width="{Binding BoxWidth}" Height="{Binding BoxHeight}">
                    <Image Source="{Binding Icon}" HorizontalAlignment="Center"
                           Width="{Binding IconSize}" Height="{Binding IconSize}" />
                    <TextBlock Text="{Binding TitleText}" Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                               Width="{Binding BoxWidth}"
                               FontSize="{Binding TitleFontSize}"
                               LineHeight="{Binding LineHeight}"
                               LineStackingStrategy="BlockLineHeight"
                               MaxHeight="{Binding MaxTitleHeight}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SubtitleText}" Foreground="{StaticResource TextTertiaryBrush}"
                               TextAlignment="Center" Margin="0,3,0,0" TextWrapping="NoWrap"
                               Width="{Binding BoxWidth}"
                               FontSize="{Binding SubtitleFontSize}"
                               Visibility="{Binding ShowSubtitle, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="16" Background="{StaticResource PanelTint}"
            BorderBrush="#33FFFFFF" BorderThickness="1" Margin="10"
            MouseLeftButtonDown="Root_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <Grid>
            <ScrollViewer x:Name="BodyScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0" Margin="0,2,0,0">
                <StackPanel Margin="14,12,14,14">

                    <!-- 标题栏 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="8" Background="{StaticResource AccentGradient}"
                                VerticalAlignment="Center">
                            <TextBlock Text="D" Foreground="White" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DeskFlow" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;"
                                    ToolTip="顶住：点一下锁住位置，再点解除" Click="TogglePin_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE81C;" ToolTip="归档记录 · 可撤销" Click="OpenHistory_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="设置" Click="OpenSettings_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8EF;" ToolTip="批处理 · 文件盘点" Click="OpenBatch_Click" />
                            <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="收起/展开" Click="ToggleCollapse_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="收起到托盘（程序继续运行）" Click="Exit_Click" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="Body" Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}">

                        <!-- 来源开关 -->
                        <Border CornerRadius="12" Background="#16FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                Padding="10,8" Margin="0,14,0,0">
                            <ItemsControl ItemsSource="{Binding Sources}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding AutoDownload, Mode=TwoWay}" Click="AutoDownload_Click"
                                                  Margin="0,3,14,3" IsEnabled="{Binding IsAvailable}"
                                                  ToolTip="勾选 = 发现即自动下载并归档；不勾 = 只进待接收列表">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextTertiaryBrush}"
                                                           FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- 待接收 -->
                        <StackPanel Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="待接收" Style="{StaticResource SectionHeader}"
                                       Foreground="{StaticResource WarningBrush}" />
                            <ItemsControl ItemsSource="{Binding PendingFiles}" ItemTemplate="{StaticResource TileTemplate}"
                                          ItemsPanel="{StaticResource TilePanel}" />
                        </StackPanel>

                        <!-- 快捷方式 -->
                        <TextBlock Text="应用与快捷方式" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Shortcuts}" ItemTemplate="{StaticResource TileTemplate}"
                                      ItemsPanel="{StaticResource TilePanel}" />

                        <!-- 最近归档 -->
                        <TextBlock Text="最近归档" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding RecentFiles}" ItemTemplate="{StaticResource TileTemplate}"
                                      ItemsPanel="{StaticResource TilePanel}" />
                        <TextBlock Text="还没有归档记录，等文件进来或打开上面的开关" Style="{StaticResource Muted}"
                                   Margin="2,4,0,0"
                                   Visibility="{Binding HasRecent, Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- 分类 -->
                        <TextBlock Text="分类" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource TileTemplate}"
                                      ItemsPanel="{StaticResource TilePanel}" />

                        <Border CornerRadius="10" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                Padding="10,8" Margin="0,14,0,0">
                            <TextBlock Text="{Binding LogText}" Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="10" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <!-- 分类详情：面板内导航，不弹资源管理器 -->
                    <StackPanel Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,14,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource IconButton}" Content="&#xE72B;"
                                    ToolTip="返回" Click="BrowseBack_Click" Margin="0,0,4,0" />
                            <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BrowseTitle}" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding BrowseSubtitle}" Foreground="{StaticResource TextTertiaryBrush}"
                                           FontSize="10.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8B7;"
                                    ToolTip="在资源管理器中打开" Click="BrowseOpenFolder_Click" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding BrowseItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                            CornerRadius="10" Padding="10,8" Margin="0,0,0,6"
                                            MouseLeftButtonUp="BrowseItem_Click" MouseRightButtonUp="BrowseItem_RightClick"
                                            Tag="{Binding}" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextTertiaryBrush}"
                                                           FontSize="10" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5" Margin="8,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 右下角缩放提示 -->
            <Path Data="M0,12 L12,0 M0,6 L6,0" Stroke="#4DFFFFFF" StrokeThickness="1.4"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,7" IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>