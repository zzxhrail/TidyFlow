<Window x:Class="DeskFlow.App.DesktopPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TidyFlow 面板" Width="960" Height="800" MinWidth="320" MinHeight="380"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True" Topmost="False"
        Background="#FF202020" AllowDrop="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Win11：窗口底就是 LayerBase，卡片靠 1px 描边分层，不用渐变 -->
        <SolidColorBrush x:Key="PanelTint" Color="#FF202020" />

        <DataTemplate x:Key="TileTemplate">
            <Button Style="{StaticResource TileButton}" Click="Tile_Click" MouseDoubleClick="Tile_DoubleClick" MouseRightButtonUp="Tile_RightClick" Tag="{Binding}"
                    MouseEnter="Tile_MouseEnter" MouseLeave="Tile_MouseLeave"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                    AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding ToolTip}">
                <Grid Height="{Binding BoxHeight}" HorizontalAlignment="Stretch">
                    <CheckBox Style="{StaticResource TilePicker}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Click="TilePicker_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-12,-2,0,0" />
                    <StackPanel Margin="0,16,0,0" ClipToBounds="True" HorizontalAlignment="Center" Width="{Binding BoxWidth}">
                        <Image Source="{Binding Icon}" HorizontalAlignment="Center"
                               Width="{Binding IconSize}" Height="{Binding IconSize}" />
                        <TextBlock Text="{Binding TitleText}" Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Width="{Binding BoxWidth}"
                                   FontSize="{Binding TitleFontSize}"
                                   LineHeight="{Binding LineHeight}"
                                   LineStackingStrategy="BlockLineHeight"
                                   MaxHeight="{Binding MaxTitleHeight}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SubtitleText}" Foreground="{StaticResource TextTertiaryBrush}"
                                   TextAlignment="Center" Margin="0,3,0,0" TextWrapping="NoWrap"
                                   HorizontalAlignment="Center"
                                   Width="{Binding BoxWidth}"
                                   FontSize="{Binding SubtitleFontSize}"
                                   Visibility="{Binding ShowSubtitle, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
        <!-- 收起状态的横向应用条：小图标，可横向滚动，双击启动 -->
        <DataTemplate x:Key="CollapsedTileTemplate">
            <Button Style="{StaticResource TileButton}" Click="Tile_Click" MouseDoubleClick="Tile_DoubleClick"
                    MouseRightButtonUp="Tile_RightClick" Tag="{Binding}" Width="60" Margin="2,2,2,2"
                    Padding="4,2,4,2" AutomationProperties.Name="{Binding Title}"
                    ToolTip="{Binding ToolTip}">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="{Binding Icon}" HorizontalAlignment="Center"
                           Width="{Binding CompactIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Height="{Binding CompactIconSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Text="{Binding Title}" FontSize="10" Margin="0,3,0,0" Width="54"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding CompactBar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Button>
        </DataTemplate>

    </Window.Resources>

    <Border x:Name="Root" CornerRadius="8" Background="{StaticResource PanelTint}"
            BorderBrush="#1AFFFFFF" BorderThickness="1" Margin="8"
            MouseLeftButtonDown="Root_MouseDown">
        <!-- 这里故意不加 DropShadowEffect：WPF 的 Effect 会让整个窗口退回软件渲染，
             拖拽缩放和滚动都会明显掉帧（这是"整体卡顿"的主因）。窗口阴影交给 DWM。 -->

        <Grid>
            <!-- 收起状态：一条窄横条，横向排应用图标，双击图标启动、双击空白展开 -->
            <Border x:Name="CollapsedBar" Visibility="Collapsed" Margin="16,8,16,8"
                    VerticalAlignment="Stretch" Background="Transparent"
                    PreviewMouseLeftButtonDown="CollapsedBar_MouseDown">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="Assets/icon-32.png" Width="26" Height="26"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CollapsedTrayButton" Style="{StaticResource CompactIconButton}"
                                Content="&#xE896;" ToolTip="最小化到系统托盘" Click="Exit_Click" />
                        <Button x:Name="CollapsedTopmostButton" Style="{StaticResource CompactIconButton}"
                                Content="&#xE840;" ToolTip="置顶（总在最前）" Click="CollapsedTopmost_Click" />
                        <Button Style="{StaticResource CompactIconButton}" Content="&#xE922;" ToolTip="展开"
                                Click="ToggleCollapse_Click" />
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  VerticalAlignment="Stretch" Margin="0,4,0,4">
                        <ItemsControl ItemsSource="{Binding CollapsedTiles}" ItemTemplate="{StaticResource CollapsedTileTemplate}"
                                      PreviewMouseLeftButtonDown="CollapsedBar_MouseDown">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 确认提示：操作完成后弹出一下（缩放 + 淡入），1.2 秒后自动消失 -->
            <Border x:Name="ConfirmCard" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,96" Padding="14,9" CornerRadius="6" Background="#F02C2C2C"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Opacity="0"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ConfirmGlyph" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ConfirmText" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 面板主体：固定高度分区，导航列随窗口高度伸展 -->
            <Grid x:Name="BodyScroller" Margin="16,14,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="220" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="Assets/icon-48.png" Width="32" Height="32"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TidyFlow" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;"
                                ToolTip="顶住：点一下锁住位置，再点解除" Click="TogglePin_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="更多（归档记录 / 设置 / 扫描磁盘）" Click="OpenMoreMenu_Click" />
                        <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="收起/展开" Click="ToggleCollapse_Click" />
                        <Button x:Name="HeaderTrayButton" Style="{StaticResource IconButton}" Content="&#xE896;"
                                ToolTip="最小化到系统托盘" Click="Exit_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="收起到托盘（程序继续运行）" Click="Exit_Click" />
                    </StackPanel>
                </Grid>

                <!-- 来源开关 -->
                <Border Grid.Row="1" CornerRadius="8" Background="#0DFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1"
                        Padding="14,12" Margin="0,16,0,0">
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding AutoDownload, Mode=TwoWay}" Click="AutoDownload_Click"
                                          Margin="0,3,14,3" IsEnabled="{Binding IsAvailable}"
                                          ToolTip="勾选 = 发现即自动下载并归档；不勾 = 只进待接收列表">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextTertiaryBrush}"
                                                   FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- 待接收 -->
                <StackPanel Grid.Row="2" Margin="0,14,0,0"
                            Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Margin="2,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="PendingSelectAllButton" Content="全选" Click="PendingSelectAll_Click" Margin="0,0,6,0" />
                            <Button x:Name="PendingAcceptButton" Content="接收选中" Click="PendingAcceptSelected_Click" Style="{StaticResource AccentButton}" Margin="0,0,6,0" />
                            <Button Content="一键忽略" Click="PendingIgnoreAll_Click" />
                        </StackPanel>
                        <TextBlock Text="待接收" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="0" />
                        <TextBlock x:Name="PendingSummary" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding PendingFiles}" ItemTemplate="{StaticResource TileTemplate}"
                                  ItemsPanel="{StaticResource TilePanel}" />
                </StackPanel>

                <!-- 导航 + 内容 -->
                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="8" Background="#08FFFFFF"
                            BorderBrush="#10FFFFFF" BorderThickness="1" Padding="5,8" VerticalAlignment="Stretch">
                        <Grid>
                            <!-- 一级 -->
                            <ListBox x:Name="NavList" Width="128" Background="Transparent" BorderThickness="0"
                                     ItemsSource="{Binding RootNav}" PreviewMouseRightButtonDown="NavList_RightClick" SelectionChanged="Nav_SelectionChanged"
                                     Visibility="{Binding IsNavRoot, Converter={StaticResource BoolToVisibility}}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="8,7" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                                       FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Badge}" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 二级（分类列表） -->
                            <Grid Visibility="{Binding IsNavCategories, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="2,0,2,6">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="返回"
                                            DockPanel.Dock="Left" Click="NavBack_Click" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="新建分类"
                                            DockPanel.Dock="Right" Margin="0,0,0,0" Click="CategoryAdd_Click" x:Name="CategoryAddButton" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="删除选中分类（Ctrl/Shift 可多选）"
                                            DockPanel.Dock="Right" Click="CategoryDelete_Click" x:Name="CategoryDeleteButton" />
                                    <TextBlock x:Name="CategorySelectionHint" Style="{StaticResource Muted}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                                </DockPanel>
                                <ListBox x:Name="CategoryNav" Grid.Row="1" Width="128" Background="Transparent"
                                         BorderThickness="0" ItemsSource="{Binding CategoryNav}" PreviewMouseRightButtonDown="CategoryNav_RightClick"
                                         SelectionChanged="CategoryNav_SelectionChanged" SelectionMode="Extended">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="8,7" />
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                       FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="ContentHost" Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- 应用与快捷方式 -->
                            <StackPanel Visibility="{Binding IsShortcutsSection, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="应用与快捷方式" Style="{StaticResource H2}" Margin="2,0,0,10" />

                                <!-- 固定位置：归档目录独立一行，永远在这儿（不再混进用户快捷方式） -->
                                <ItemsControl ItemsSource="{Binding SystemPlaces}" ItemTemplate="{StaticResource TileTemplate}"
                                              ItemsPanel="{StaticResource TilePanel}" />

                                <TextBlock Text="快捷方式" Style="{StaticResource Muted}" Margin="2,10,0,8" />
                                <ItemsControl ItemsSource="{Binding Shortcuts}" ItemTemplate="{StaticResource TileTemplate}"
                                              ItemsPanel="{StaticResource TilePanel}" />
                            </StackPanel>

                            <!-- 最近归档 -->
                            <StackPanel Visibility="{Binding IsRecentSection, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="最近归档" Style="{StaticResource H2}" Margin="2,0,0,10" />
                                <ItemsControl ItemsSource="{Binding RecentFiles}" ItemTemplate="{StaticResource TileTemplate}"
                                              ItemsPanel="{StaticResource TilePanel}" />
                                <TextBlock Text="还没有归档记录，等文件进来或打开上面的开关" Style="{StaticResource Muted}"
                                           Margin="2,4,0,0"
                                           Visibility="{Binding HasRecent, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBlock Text="把文件拖到左侧分类上即可收录；按住 Shift 拖 = 移动，直接拖 = 复制"
                                           Style="{StaticResource Muted}" Margin="2,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- 分类详情 -->
                            <Grid Visibility="{Binding IsCategorySection, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                <Grid Margin="2,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BrowseTitle}" Style="{StaticResource H2}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding BrowseSubtitle}" Style="{StaticResource Muted}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="BrowseSelectAllButton" Content="全选" Click="BrowseSelectAll_Click" Margin="0,0,6,0" />
                                        <Button x:Name="BrowseDeleteButton" Content="删除选中" Click="BrowseDeleteSelected_Click"
                                                Style="{StaticResource AccentButton}" Margin="0,0,6,0" />
                                        <Button x:Name="BrowseMoveButton" Content="移动" Click="BrowseMove_Click" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8B7;"
                                                ToolTip="在资源管理器中打开" Click="BrowseOpenFolder_Click" />
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding BrowseItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0AFFFFFF" CornerRadius="4" Padding="10,8" Margin="0,0,0,4"
                                                    MouseLeftButtonUp="BrowseItem_Click" MouseRightButtonUp="BrowseItem_RightClick"
                                                            MouseEnter="BrowseRow_MouseEnter" MouseLeave="BrowseRow_MouseLeave"
                                                    Tag="{Binding}" Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#17FFFFFF" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" Style="{StaticResource RowPicker}" Margin="0,0,8,0"
                                                              VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Click="BrowseCheck_Click" />
                                                    <Image Grid.Column="1" Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center"
                                                               Style="{StaticResource Muted}" Margin="8,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>

                                <!-- 移动模式：右侧显示目标分类 + 该分类已有文件预览 -->
                                <Border Grid.Column="1" Width="360" Margin="12,0,0,0" Padding="12"
                                        CornerRadius="8" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                        Visibility="{Binding IsMoveModeVisible, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top">
                                            <TextBlock Text="移动到…" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding MoveTargetHint}" Style="{StaticResource Muted}"
                                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                                        </StackPanel>
                                        <Button DockPanel.Dock="Bottom" Content="取消移动" Click="BrowseMoveCancel_Click" Margin="0,8,0,0" />
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <ListBox x:Name="MoveTargetList" Grid.Row="0" MaxHeight="180"
                                                     ItemsSource="{Binding CategoryNav}"
                                                     SelectionChanged="MoveTarget_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <ItemsControl Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding MoveTargetItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="6,0,0,0" FontSize="11.5"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="4" CornerRadius="8" Background="#0AFFFFFF" Padding="14,10" Margin="0,14,0,0">
                    <TextBlock Text="{Binding LogText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                </Border>
            </Grid>

            <!-- 右下角缩放提示 -->
            <Path Data="M0,12 L12,0 M0,6 L6,0" Stroke="#4DFFFFFF" StrokeThickness="1.4"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,7" IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>