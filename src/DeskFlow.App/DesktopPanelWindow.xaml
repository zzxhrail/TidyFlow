<Window x:Class="DeskFlow.App.DesktopPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DeskFlow 面板" Width="376" Height="640" MinWidth="280" MinHeight="180"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True" Topmost="False"
        Background="#181A1F"
        FontFamily="Microsoft YaHei UI, Segoe UI" TextOptions.TextFormattingMode="Display">

    <!-- 用 WindowChrome 拿到系统级边框/窗口阴影；AllowsTransparency=False 避开
         "分层窗口最小化后不重绘" 的 WPF 老问题（Windows 11 上再由 DWM 负责圆角）。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="-1" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 格子尺寸/字号全部绑定到视图模型的密度属性，窗口一拖就重排 -->
        <DataTemplate x:Key="TileTemplate">
            <Button Style="{StaticResource TileButton}" Click="Tile_Click" MouseRightButtonUp="Tile_RightClick" Tag="{Binding}">
                <StackPanel ClipToBounds="True" Width="{Binding BoxWidth}" Height="{Binding BoxHeight}">
                    <Image Source="{Binding Icon}" HorizontalAlignment="Center"
                           Width="{Binding IconSize}" Height="{Binding IconSize}" />
                    <TextBlock Text="{Binding TitleText}" Foreground="#E3E6EA" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,5,0,0"
                               Width="{Binding BoxWidth}"
                               FontSize="{Binding TitleFontSize}"
                               LineHeight="{Binding LineHeight}"
                               LineStackingStrategy="BlockLineHeight"
                               MaxHeight="{Binding MaxTitleHeight}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SubtitleText}" Foreground="#6F7681" TextAlignment="Center"
                               Margin="0,2,0,0" TextWrapping="NoWrap"
                               Width="{Binding BoxWidth}"
                               FontSize="{Binding SubtitleFontSize}"
                               Visibility="{Binding ShowSubtitle, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="0" Background="#181A1F" BorderBrush="#33FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseDown">

        <Grid>
            <ScrollViewer x:Name="BodyScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel Margin="12,10,12,12">

                    <!-- 标题栏（可拖动） -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="5" Background="#2F6BFF" VerticalAlignment="Center">
                            <TextBlock Text="D" Foreground="White" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DeskFlow" Foreground="#EDEFF2" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Status}" Foreground="#7E858F" FontSize="10" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;"
                                    ToolTip="顶住：点一下锁住位置，再点解除" Click="TogglePin_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="设置" Click="OpenSettings_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8EF;" ToolTip="批处理 · 文件盘点" Click="OpenBatch_Click" />
                            <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="收起/展开" Click="ToggleCollapse_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="退出" Click="Exit_Click" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="Body">

                        <!-- 来源开关 -->
                        <Border Background="#14FFFFFF" CornerRadius="8" Padding="8,6" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding Sources}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding AutoDownload, Mode=TwoWay}" Click="AutoDownload_Click"
                                                  Margin="0,2,12,2" VerticalContentAlignment="Center" IsEnabled="{Binding IsAvailable}"
                                                  ToolTip="勾选 = 发现即自动下载并归档；不勾 = 只进待接收列表">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Foreground="#DDE1E6" FontSize="11.5" />
                                                <TextBlock Text="{Binding Detail}" Foreground="#6F7681" FontSize="10" Margin="4,0,0,0" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- 待接收 -->
                        <StackPanel Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="待接收（点击归档 / 右键忽略）" Style="{StaticResource SectionHeader}" Foreground="#FFCE6B" />
                            <ItemsControl ItemsSource="{Binding PendingFiles}" ItemTemplate="{StaticResource TileTemplate}" ItemsPanel="{StaticResource TilePanel}" />
                        </StackPanel>

                        <!-- 快捷方式 -->
                        <TextBlock Text="应用与快捷方式" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Shortcuts}" ItemTemplate="{StaticResource TileTemplate}" ItemsPanel="{StaticResource TilePanel}" />

                        <!-- 最近归档 -->
                        <TextBlock Text="最近归档" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding RecentFiles}" ItemTemplate="{StaticResource TileTemplate}" ItemsPanel="{StaticResource TilePanel}" />
                        <TextBlock Text="还没有归档记录，等文件进来或点上面的来源开关" Style="{StaticResource Hint}"
                                   Foreground="#5E646D" Margin="2,2,0,0"
                                   Visibility="{Binding HasRecent, Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- 分类 -->
                        <TextBlock Text="分类" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource TileTemplate}" ItemsPanel="{StaticResource TilePanel}" />

                        <Border Background="#10FFFFFF" CornerRadius="6" Padding="8,6" Margin="0,12,0,0">
                            <TextBlock Text="{Binding LogText}" Foreground="#8A9099" FontSize="10" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 右下角尺寸提示（拖动由 WM_NCHITTEST 处理，这里只是视觉标记） -->
            <Path Data="M0,12 L12,0 M0,6 L6,0" Stroke="#55FFFFFF" StrokeThickness="1.4"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5" IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>