<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\tidyflow.ico</ApplicationIcon>
    <!-- 托盘图标用 WinForms 的 NotifyIcon（最省事、行为最接近系统原生） -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TidyFlow</AssemblyName>
    <RootNamespace>DeskFlow.App</RootNamespace>
    <Product>TidyFlow</Product>
    <AssemblyTitle>TidyFlow 文件管家</AssemblyTitle>
    <Version>0.8.0</Version>
    <FileVersion>0.8.0.0</FileVersion>
    <AssemblyVersion>0.8.0.0</AssemblyVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms 打开后会往全局注入 System.Windows.Forms/System.Drawing 的 using，
         跟 WPF 的 Application / MenuItem 撞名，这里去掉，需要的地方显式 using -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskFlow.Core\DeskFlow.Core.csproj" />
    <ProjectReference Include="..\DeskFlow.Infrastructure\DeskFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\DeskFlow.Deployment\DeskFlow.Deployment.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon-16.png" />
    <Resource Include="Assets\icon-24.png" />
    <Resource Include="Assets\icon-32.png" />
    <Resource Include="Assets\icon-48.png" />
    <Resource Include="Assets\icon-64.png" />
    <Resource Include="Assets\icon-128.png" />
    <Resource Include="Assets\icon-256.png" />
    <Resource Include="Assets\tidyflow.ico" />
  </ItemGroup>
</Project>