<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\tidyflow.ico</ApplicationIcon>
    <!-- 鎵樼洏鍥炬爣鐢?WinForms 鐨?NotifyIcon锛堟渶鐪佷簨銆佽涓烘渶鎺ヨ繎绯荤粺鍘熺敓锛?-->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TidyFlow</AssemblyName>
    <RootNamespace>DeskFlow.App</RootNamespace>
    <Product>TidyFlow</Product>
    <AssemblyTitle>TidyFlow 鏂囦欢绠″</AssemblyTitle>
    <Version>0.9.24</Version>
    <FileVersion>0.9.24.0</FileVersion>
    <AssemblyVersion>0.9.24.0</AssemblyVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms 鎵撳紑鍚庝細寰€鍏ㄥ眬娉ㄥ叆 System.Windows.Forms/System.Drawing 鐨?using锛?         璺?WPF 鐨?Application / MenuItem 鎾炲悕锛岃繖閲屽幓鎺夛紝闇€瑕佺殑鍦版柟鏄惧紡 using -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskFlow.Core\DeskFlow.Core.csproj" />
    <ProjectReference Include="..\DeskFlow.Infrastructure\DeskFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\DeskFlow.Deployment\DeskFlow.Deployment.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon-16.png" />
    <Resource Include="Assets\icon-24.png" />
    <Resource Include="Assets\icon-32.png" />
    <Resource Include="Assets\icon-48.png" />
    <Resource Include="Assets\icon-64.png" />
    <Resource Include="Assets\icon-128.png" />
    <Resource Include="Assets\icon-256.png" />
    <Resource Include="Assets\tidyflow.ico" />
  </ItemGroup>
</Project>





































