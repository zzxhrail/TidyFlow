<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用 WinForms 的 NotifyIcon（最省事、行为最接近系统原生） -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DeskFlow</AssemblyName>
    <RootNamespace>DeskFlow.App</RootNamespace>
    <Product>DeskFlow</Product>
    <AssemblyTitle>DeskFlow 批量文件盘点与报表</AssemblyTitle>
    <Version>0.7.0</Version>
    <FileVersion>0.7.0.0</FileVersion>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms 打开后会往全局注入 System.Windows.Forms/System.Drawing 的 using，
         跟 WPF 的 Application / MenuItem 撞名，这里去掉，需要的地方显式 using -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskFlow.Core\DeskFlow.Core.csproj" />
    <ProjectReference Include="..\DeskFlow.Infrastructure\DeskFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\DeskFlow.Deployment\DeskFlow.Deployment.csproj" />
  </ItemGroup>

</Project>