<Window x:Class="DeskFlow.App.Move.MoveConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认移动" Height="520" Width="760" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceStrongBrush}" FontFamily="{StaticResource FluentFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" Text="确认移动" Style="{StaticResource H2}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="8" Background="#0AFFFFFF" Padding="8">
            <ListView x:Name="PreviewList" BorderThickness="0" Background="Transparent"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="文件" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="从" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding FromCategory}" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="到" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding ToCategory}" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="取消" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="确认移动" Style="{StaticResource AccentButton}"
                    MinWidth="110" Click="Confirm_Click" IsDefault="True" />
            <TextBlock x:Name="HintText" Style="{StaticResource Muted}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
