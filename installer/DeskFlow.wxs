<?xml version="1.0" encoding="utf-8"?>
<!--
  DeskFlow 安装包（WiX v7 / MSI，per-user 安装，不需要管理员权限）
  构建：build\pack-installer.ps1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="DeskFlow"
           Manufacturer="DeskFlow"
           Version="0.5.2"
           UpgradeCode="8F1D0A5C-4C2E-4E9B-9A6E-2B7C3F5D8A10"
           Scope="perUser"
           Compressed="yes"
           Language="2052">

    <SummaryInformation Description="DeskFlow 文件管家：自动接住 QQ / 微信 / 钉钉 收到的文件并归档" />

    <!-- 升级安装：先卸旧版再装新版，数据目录（%LOCALAPPDATA%\DeskFlow）不受影响 -->
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 DeskFlow，请先卸载。" />
    <MediaTemplate EmbedCab="yes" />

    <!-- 安装到 %LOCALAPPDATA%\Programs\DeskFlow，避免和用户数据目录同名 -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="DeskFlow" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="DeskFlow" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="DeskFlow" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="Shortcuts" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="C1A0F2D4-6B3E-4B7A-9C21-5D8E7F0A1B32">
        <File Id="DeskFlowExe" Source="$(var.SourceExe)" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="Shortcuts" Directory="AppMenuFolder" Guid="D2B1E3F5-7C4A-4C8B-8D32-6E9F8A1B2C43">
      <!-- 开始菜单 + 桌面快捷方式：双击就是面板 -->
      <Shortcut Id="StartMenuShortcut" Name="DeskFlow" Description="文件管家"
                Target="[INSTALLFOLDER]DeskFlow.exe" WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="DesktopShortcut" Name="DeskFlow" Description="文件管家"
                Target="[INSTALLFOLDER]DeskFlow.exe" WorkingDirectory="INSTALLFOLDER" Directory="DesktopFolder" />
      <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" Directory="AppMenuFolder" />
      <RegistryValue Root="HKCU" Key="Software\DeskFlow" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
